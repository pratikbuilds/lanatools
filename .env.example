# Local configuration for `bun run dev` and web builds.
# Copy this file to root .env and fill it in. Keep Privy credentials separate from production.

# One network for API, MCP and web. For a real mainnet test, set mainnet
# and use a matching mainnet SOLANA_RPC_URL. No VITE_ network variable is needed.
SOLANA_NETWORK=devnet

# A Privy app for local development only. `bun run dev` refuses the
# production app. The dashboard and consent page use the same app ID.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional. The app's verification key (Privy dashboard → Configuration →
# App settings). Access-token checks then stay on this Worker.
PRIVY_JWT_VERIFICATION_KEY=

# The payment signer for that Privy app. Create it once with
#   bun --env-file=.env apps/api/scripts/create-payment-signer.ts
PRIVY_PAYMENT_SIGNER_ID=
PRIVY_PAYMENT_SIGNER_KEY=

# Optional. The transaction signer, which signs transactions agents request
# with delivery "embedded". Without it, embedded delivery is off. Create it
# once with
#   bun --env-file=.env apps/api/scripts/create-transaction-signer.ts
PRIVY_TRANSACTION_SIGNER_ID=
PRIVY_TRANSACTION_SIGNER_KEY=

# A provider RPC URL matching SOLANA_NETWORK. Startup verifies its genesis hash.
# Solana's public api.devnet.solana.com refuses Workers.
SOLANA_RPC_URL=

# Optional. Without it, Jupiter tools return a configuration error.
JUPITER_API_KEY=

# Optional. Without it, catalog search uses keyword matching.
TYPESAFE_API_KEY=

# Optional. The RPC `bun run dev:fund` gives the Solana CLI. Without it,
# funding uses Solana's public devnet RPC, which is rate limited.
# dev:fund refuses to run when SOLANA_NETWORK=mainnet.
# DEVNET_RPC_URL=
