{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--cwd", "apps/web", "dev"],
      "port": 5173
    },
    {
      "name": "proof",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--cwd", "apps/proof", "dev"],
      "port": 5174
    },
    {
      "name": "consent",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "apps/mcp",
        "vite",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    },
    {
      "name": "dev",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "design-concepts",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4800",
        "-d",
        "docs/design/dashboard-concepts"
      ],
      "port": 4800
    },
    {
      "name": "api",
      "runtimeExecutable": "bunx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "-c",
        "apps/api/wrangler.local.jsonc",
        "--port",
        "3000",
        "--local",
        "--persist-to",
        "apps/api/.wrangler/state"
      ],
      "port": 3000
    }
  ]
}
