{
  "name": "@lanatools/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c wrangler.local.jsonc --port 3000 --local",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local -c wrangler.local.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote -c wrangler.jsonc",
    "db:smoke:local": "bun run db:migrate:local && bun scripts/smoke-local.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "start": "bun dist/index.js"
  },
  "dependencies": {
    "@lanatools/catalog": "workspace:*",
    "@lanatools/contracts": "workspace:*",
    "@lanatools/helius": "workspace:*",
    "@lanatools/jupiter": "workspace:*",
    "@lanatools/phoenix": "workspace:*",
    "@lanatools/toolkit": "workspace:*",
    "@privy-io/node": "^0.35.0",
    "@solana-program/memo": "0.11.0",
    "@solana-program/system": "0.12.2",
    "@solana-program/token": "^0.14.0",
    "@solana/keychain-privy": "1.4.0",
    "@solana/kit": "~6.10.0",
    "@solana/kit-plugin-rpc": "0.12.1",
    "@solana/pay-kit": "0.12.0",
    "arktype": "catalog:",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.8",
    "mppx": "^0.11.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260901.1",
    "drizzle-kit": "0.31.10",
    "zod": "4.4.3"
  }
}
