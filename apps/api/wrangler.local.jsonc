{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lanatools-api-local",
  "main": "src/worker.local.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  // Revoking a client in the dashboard also deletes its OAuth tokens, which
  // only the MCP Worker can reach. The MCP Worker binds back to this one.
  "services": [
    {
      "binding": "MCP",
      "service": "lanatools-mcp-local",
      "entrypoint": "McpTokenService",
    },
  ],
  // Agent payments run on this network only. SOLANA_RPC_URL (a secret) must
  // serve it; the Worker checks its genesis hash before paying. The public
  // api.devnet.solana.com refuses Workers, so use a provider's devnet URL.
  "vars": { "SOLANA_NETWORK": "devnet", "WEB_ORIGIN": "http://localhost:5173" },
  "ratelimits": [
    {
      "name": "CATALOG_SEARCH_LIMITER",
      "namespace_id": "2001003",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "TRANSACTION_LINK_LIMITER",
      "namespace_id": "2001002",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "PHOENIX_PUBLIC_LIMITER",
      "namespace_id": "2001005",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "SIGNUP_LIMITER",
      "namespace_id": "2001001",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lanatools-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
}
