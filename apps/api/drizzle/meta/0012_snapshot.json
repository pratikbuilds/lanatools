        "transaction_attempt_one_active": {
          "name": "transaction_attempt_one_active",
          "columns": ["request_id"],
          "isUnique": true,
          "where": "\"transaction_attempt\".\"state\" in ('preparing', 'prepared', 'issued', 'signing', 'signed', 'submitting', 'submitted', 'uncertain')"
        }
      },
      "foreignKeys": {
        "transaction_attempt_request_id_transaction_request_id_fk": {
          "name": "transaction_attempt_request_id_transaction_request_id_fk",
          "tableFrom": "transaction_attempt",
          "tableTo": "transaction_request",
          "columnsFrom": ["request_id"],
          "columnsTo": ["id"],
          "onDelete": "no action",
          "onUpdate": "no action"
        }
      },
      "compositePrimaryKeys": {},
      "uniqueConstraints": {},
      "checkConstraints": {
        "transaction_attempt_number_positive": {
          "name": "transaction_attempt_number_positive",
          "value": "\"transaction_attempt\".\"number\" > 0"
        },
        "transaction_attempt_state": {
          "name": "transaction_attempt_state",
          "value": "\"transaction_attempt\".\"state\" in ('preparing', 'prepared', 'issued', 'signing', 'signed', 'submitting', 'submitted', 'uncertain', 'succeeded', 'failed', 'expired', 'abandoned')"
        },
        "transaction_attempt_network": {
          "name": "transaction_attempt_network",
          "value": "\"transaction_attempt\".\"network\" in ('devnet', 'mainnet')"
        },
        "transaction_attempt_prepared": {
          "name": "transaction_attempt_prepared",
          "value": "\"transaction_attempt\".\"state\" in ('preparing', 'abandoned') or (\"transaction_attempt\".\"message_base64\" is not null and \"transaction_attempt\".\"message_hash\" is not null and \"transaction_attempt\".\"preparation_slot\" is not null and \"transaction_attempt\".\"blockhash\" is not null and \"transaction_attempt\".\"last_valid_block_height\" is not null)"
        },
        "transaction_attempt_signed": {
          "name": "transaction_attempt_signed",
          "value": "\"transaction_attempt\".\"state\" not in ('signed', 'submitting', 'submitted') or (\"transaction_attempt\".\"signed_base64\" is not null and \"transaction_attempt\".\"signature\" is not null)"
        },
        "transaction_attempt_evidence": {
          "name": "transaction_attempt_evidence",
          "value": "\"transaction_attempt\".\"state\" not in ('submitted', 'uncertain', 'succeeded', 'failed', 'expired') or \"transaction_attempt\".\"evidence\" is not null"
        }
      }
    },
