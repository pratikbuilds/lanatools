{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lanatools-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "b5569935f933970ae15fd5b26ba93d7a",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  // Revoking a client in the dashboard also deletes its OAuth tokens, which
  // only the MCP Worker can reach. The MCP Worker binds back to this one.
  "services": [
    {
      "binding": "MCP",
      "service": "lanatools-mcp",
      "entrypoint": "McpTokenService",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lanatools-production",
      "database_id": "8670e5d1-a2d5-441b-9bb4-bb2512144bbe",
      "migrations_dir": "drizzle",
    },
  ],
  "routes": [{ "pattern": "api.lanatools.sh", "custom_domain": true }],
}
