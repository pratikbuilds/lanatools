{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lanatools-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "b5569935f933970ae15fd5b26ba93d7a",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  // The page requests /api on this origin. Only those paths run the Worker;
  // everything else is the Vite build, with SPA fallback for client routes.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "services": [{ "binding": "API", "service": "lanatools-api" }],
  "routes": [{ "pattern": "lanatools.sh", "custom_domain": true }],
}
