{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lanatools-mcp-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  // Calls from agents that are not logged in, per IP (specs/no-login-access.md).
  "ratelimits": [
    {
      "name": "NO_LOGIN_LIMITER",
      "namespace_id": "2001004",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "services": [
    {
      "binding": "API",
      "service": "lanatools-api-local",
      "entrypoint": "McpAccessService",
    },
  ],
  "vars": {
    "MCP_ORIGIN": "http://localhost:8788",
    // To try LanaTools Mobile locally, register it on the local /register
    // and set its client ID here or in .dev.vars.
    "FIRST_PARTY_CLIENT_IDS": "",
  },
}
